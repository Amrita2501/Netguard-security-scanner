# Copy this file to `.env` in the backend/ directory and adjust as needed.
# All values shown are the built-in defaults - .env is optional for local
#/demo use, but recommended before deploying anywhere reachable by others.

# --- Server / CORS -----------------------------------------------------
# Comma-separated list of frontend origins allowed to call this API.
NETGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One of: DEBUG, INFO, WARNING, ERROR
NETGUARD_LOG_LEVEL=INFO

# --- Auth ----------------------------------------------------------------
# IMPORTANT: generate a real random value before deploying anywhere
# reachable by other people, e.g.:  python3 -c "import secrets; print(secrets.token_hex(32))"
NETGUARD_SESSION_SECRET=replace-with-a-random-secret

# Session token lifetime, in seconds (default: 8 hours)
NETGUARD_TOKEN_TTL_SECONDS=28800

# --- Storage --------------------------------------------------------------
# Where the SQLite DB, reports, and local user file are stored.
# Defaults to backend/data if unset.
# NETGUARD_DATA_DIR=/path/to/data

# --- Scanning ---------------------------------------------------------
# SNMPv2c community string used when polling network devices during a scan.
NETGUARD_SNMP_COMMUNITY=public

# Nmap port ranges / arguments per scan profile - only override if you know
# what you're changing here.
# NETGUARD_DEFAULT_PORT_RANGE=21,22,23,25,53,80,110,139,143,443,445,993,995,1433,1521,3306,3389,5432,5900,6379,8080,8443,27017
# NETGUARD_DEEP_PORT_RANGE=1-65535
# NETGUARD_NMAP_ARGS_FAST=-sV -O --osscan-guess -T4 --max-retries 1 --host-timeout 30s
# NETGUARD_NMAP_ARGS_DEEP=-sV -O --osscan-guess -T4 --version-intensity 5
